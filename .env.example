# Copy to .env and adjust. Everything here has a default in scripts/00_lib.sh, so an empty .env works
# against the docker compose stack from docker/compose.yml.

# --- PostgreSQL: the source of truth -------------------------------------------------------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=beer
PG_DB=beerdb
# How ClickHouse reaches PostgreSQL. Differs from PG_HOST:PG_PORT when ClickHouse runs in a container
# (docker compose network: postgres:5432).
PG_ADDR_FROM_CH=127.0.0.1:5432
# Read-only role that ClickHouse uses (created by 01_seed.sh)
PG_RO_USER=ch_reader
PG_RO_PASSWORD=ch_reader_pw

# --- ClickHouse: the sidekick ----------------------------------------------------------------
CH_HOST=127.0.0.1
CH_PORT=9000            # native protocol (clickhouse-client); 9440 + CH_SECURE=true for TLS
CH_HTTP_PORT=8123
CH_USER=default
CH_PASSWORD=beer           # matches docker/compose.yml; use your own for a real server
CH_SECURE=false
CH_DB=beer
# The client command. 'clickhouse client' works with the single binary, 'clickhouse-client' with the packages.
CH_CLIENT="clickhouse client"

# --- Demo data -------------------------------------------------------------------------------
ROWS=200000             # rows seeded into PostgreSQL by 01_seed.sh
BENCH_ROWS=2000000      # rows for 70_benchmark.sh
BENCH_ROUNDS=3          # timed runs per query (best one counts)

# --- Path 4 (Kafka + Debezium, docker/compose.kafka.yml) -------------------------------------
KAFKA_BROKER_FROM_CH=kafka:19092
CONNECT_URL=http://127.0.0.1:8083

# --- Path 5 (Aiven) --------------------------------------------------------------------------
AVN_PROJECT=
AVN_CLOUD=google-europe-west1
AVN_PG_PLAN=startup-4
AVN_CH_PLAN=startup-16
AVN_PG_NAME=beer-pg
AVN_CH_NAME=beer-clickhouse
